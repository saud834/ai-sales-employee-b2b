# Required
HEYGEN_API_KEY=""
PORTRAIT_IMAGE_PATH="./ava-portrait.png"   # from step 1 in BRIEF.md - generate this first

# Optional: higher-quality custom voice via ElevenLabs instead of HeyGen's
# built-in TTS library. If unset, HEYGEN_VOICE_ID (or HeyGen's default) is used.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Optional fallback if not using ElevenLabs - pick a "young adult American
# female, conversational" voice from HeyGen's voice library and paste its ID.
HEYGEN_VOICE_ID=""

OUTPUT_PATH="./output/ava-10s.mp4"
