# Anthropic API key — required for lead scoring & email drafting
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# SQLite database file
DATABASE_PATH=./data/sales-agent.db

# Outreach mode: "draft" (default, safe) writes emails to data/outbox instead of sending.
# Set to "send" to actually deliver mail via SMTP once the settings below are configured.
OUTREACH_MODE=draft

# SMTP settings (only needed when OUTREACH_MODE=send)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Your Sales Team
SMTP_FROM_EMAIL=sales@yourcompany.com

# Ideal Customer Profile — free text used to steer lead qualification & messaging
ICP_DESCRIPTION=B2B SaaS companies with 20-500 employees in North America or Europe, particularly in fintech, healthtech, or logistics, who are likely to need workflow automation or sales tooling.
COMPANY_NAME=Your Company
PRODUCT_PITCH=We help B2B teams automate lead qualification and outbound outreach so reps spend time only on deals worth closing.

# Minimum qualification score (0-100) for a lead to receive outreach
QUALIFICATION_THRESHOLD=60
