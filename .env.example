# Copy this file to .env.local and fill in values.

# Anthropic API key for real AI generation. Leave empty to run entirely on
# the built-in MockProvider (deterministic, offline, no network calls) so
# the app is testable without any API key.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for planning/content/edits.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/app.db
