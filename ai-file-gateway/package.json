{
  "name": "ai-file-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute ai-file-gateway-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute ai-file-gateway-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
